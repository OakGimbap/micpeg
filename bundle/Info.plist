<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- CFBundleExecutable is MicpegApp, not Micpeg, because Contents/MacOS also holds the
         daemon+CLI as `micpeg`, and APFS is case-insensitive by default: MacOS/Micpeg and
         MacOS/micpeg are one file, and the second copy silently replaces the first
         (measured — docs/verification.md). Renaming the app side rather than the daemon
         side keeps `ps` and Activity Monitor showing `micpeg` for the background process,
         while the app's visible name comes from CFBundleName either way. -->
    <key>CFBundleExecutable</key>            <string>MicpegApp</string>
    <key>CFBundleIdentifier</key>            <string>com.micpeg.app</string>
    <key>CFBundleName</key>                  <string>Micpeg</string>
    <key>CFBundlePackageType</key>           <string>APPL</string>
    <!-- The only place a version number lives. Sources/MicpegUI/SettingsWindow.swift reads it
         back through Bundle.main for the About row, scripts/version.sh reads it for the DMG
         name and the release tag, and the release workflow refuses a tag that is not
         v + CFBundleShortVersionString. A second store means a release where the About box
         and the download disagree. -->
    <key>CFBundleShortVersionString</key>    <string>0.9.0</string>
    <key>CFBundleVersion</key>               <string>2</string>
    <key>CFBundleInfoDictionaryVersion</key> <string>6.0</string>

    <!-- The language Sources/MicpegUI/Strings.swift is written in, and the languages that ship.
         English has no table — its keys are its strings — so this list is what declares it;
         scripts/bundle.sh checks that every other entry has a table and every table an entry.
         Declaring Korean is also what lets AppKit's own menus follow the app into Korean, and
         what lists Micpeg in System Settings › Language & Region › Applications. -->
    <key>CFBundleDevelopmentRegion</key>     <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>ko</string>
    </array>

    <!-- docs/app-design.md, "Deployment target": @Observable is macOS 14. -->
    <key>LSMinimumSystemVersion</key>        <string>14.0</string>
    <key>NSHighResolutionCapable</key>       <true/>

    <!-- CFBundleIconFile names Resources/AppIcon.icns, which scripts/bundle.sh compiles from
         bundle/AppIcon.iconset with iconutil. CFBundleIconName is deliberately absent: it names
         an entry in a compiled asset catalog, there is no Assets.car and no Xcode project to
         produce one, and setting it without a catalog leaves Finder unable to resolve the icon
         at all. -->
    <key>CFBundleIconFile</key>              <string>AppIcon</string>

    <!-- LSUIElement is deliberately absent: a Dock icon is wanted. The app is not a menu
         bar item, and closing its window must not look like it stopped the feature. -->

    <!-- Shown in the TCC prompt. The app opens the microphone only during the input test
         (stage 4). Absent, the app is killed on first capture. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Micpeg opens the microphone only while you run the input test, so you can hear and see that the pinned microphone is the one actually recording.</string>
</dict>
</plist>
